{
  "name": "openlocker",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "description": "Lock Chrome domains with your MacBook's Touch ID.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.mjs",
    "build:native": "bash scripts/build-native.sh",
    "test:native": "python3 tests/native_protocol.py",
    "package": "bash scripts/package.sh",
    "build:mac": "bash scripts/build-mac-app.sh",
    "test:mac": "bash scripts/test-mac-app.sh",
    "build:installer": "bash scripts/build-installer.sh",
    "test:installer": "bash scripts/test-installer.sh",
    "build:release": "OPENLOCKER_RELEASE=1 bash scripts/build-installer.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
